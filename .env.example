# ============================================================================
#  Lunara - Environment Variables
#  Copy this file to `.env` and fill in real values:  cp .env.example .env
#  `.env` is gitignored. NEVER commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. DATABASE - Neon PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
# Create a project at https://neon.tech, then copy the *pooled* connection
# string from the Neon console (Connection Details -> Connection string).
#
# Use the POOLED endpoint (host contains `-pooler`) for the application, so
# serverless/edge invocations reuse connections instead of exhausting them.
# `sslmode=require` is mandatory for Neon.
#
# Shape:
#   postgresql://<user>:<password>@ep-<id>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.us-east-2.aws.neon.tech/lunara?sslmode=require"

# Optional: unpooled/direct endpoint. The Prisma CLI uses `DATABASE_URL` for
# migrations (see prisma.config.ts). If you prefer to run migrations over the
# direct connection, add this and point `datasource.url` at it in prisma.config.ts.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.us-east-2.aws.neon.tech/lunara?sslmode=require"

# Optional: dedicated shadow database for `prisma migrate dev` on databases
# where the CLI cannot create one automatically.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.us-east-2.aws.neon.tech/lunara_shadow?sslmode=require"


# ---------------------------------------------------------------------------
# 2. AUTH - Session signing secret (REQUIRED)
# ---------------------------------------------------------------------------
# Must be a high-entropy random string, at least 32 characters (48+ recommended).
# Generate one with:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# Changing this value invalidates every existing session and recovery token.
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"


# ---------------------------------------------------------------------------
# 3. APPLICATION (optional)
# ---------------------------------------------------------------------------
# Public origin of the deployment. Used for absolute URLs (e.g. share links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment. `next dev` / `next build` manage this automatically.
# NODE_ENV="development"


# ---------------------------------------------------------------------------
# 4. OPTIONAL - Email delivery for password reset
# ---------------------------------------------------------------------------
# Lunara's initial release uses security-question recovery and needs NO email
# provider. The `PasswordRecoveryService` abstraction (lib/auth/recovery/) is
# already in place so an email provider can be plugged in later without
# touching call sites. Implement one of the adapters below and set RECOVERY_EMAIL_DRIVER.
#
# RECOVERY_EMAIL_DRIVER="resend"        # resend | sendgrid | smtp | console
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxx"
# RECOVERY_EMAIL_FROM="Lunara <no-reply@yourdomain.com>"
#
# SMTP_HOST="smtp.yourprovider.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASSWORD="xxxxxxxxxxxxxxxx"


# ---------------------------------------------------------------------------
# 5. OPTIONAL - Admin bootstrap
# ---------------------------------------------------------------------------
# The seed script promotes the demo admin account using this email.
ADMIN_EMAIL="admin@lunara.app"

# Seed credentials for the demo accounts created by `npm run db:seed`.
# NEVER use these values in production.
SEED_USER_PASSWORD="Lunara!Demo2026"
SEED_ADMIN_PASSWORD="Lunara!Admin2026"
